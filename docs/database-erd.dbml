  vertical_params "numeric[]" [note: 'Distribution shape parameters (e.g. Beta\'s two shape params); NULL when distribution_type = uniform']
  horizontal_params "numeric[]"
  total_leaf_area_m2 numeric(10,2)
  source text [not null, note: 'species_literature_default = literature parameters for this species; fitted = fit to our own data; measured = destructive/allometric measurement']
  created_at "timestamp with time zone" [default: `now()`]
  created_by "character varying(200)"

  Note: 'Crown leaf area density/distribution (not per-leaf geometry -- QSM is wood-only) for growpy/PVE procedural leaf instancing'
}

