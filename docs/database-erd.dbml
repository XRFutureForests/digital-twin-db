Table shared.campaigns {
  campaign_id integer [increment, pk]
  campaign_name "character varying(200)" [not null]
  campaign_type "character varying(50)" [not null, note: 'Type of data collection campaign']
  location_id integer
  start_date date [not null]
  end_date date
  description text
  methodology text [note: 'Description of data collection methodology used']
  equipment text [note: 'Equipment used (e.g., scanner model, measurement tools)']
  personnel text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  indexes {
    campaign_name [unique]
  }

  Note: 'Data collection campaigns (LiDAR flights, field inventories, sensor deployments)'
}

Table shared.climate_pathways {
  climate_pathway_id smallint [pk]
  climate_pathway_name "character varying(50)" [not null]
  label "character varying(50)"
  description text
  created_at "timestamp with time zone" [default: `now()`]

  indexes {
    climate_pathway_name [unique]
  }

  Note: 'Climate axis of a scenario. Pathway 0 (historical) is the observed 1981-2010 climatology held constant; the others are the CMIP6 SSPs the open-data connector acquires (CHELSA temperature/precipitation, SSP CO2). Names are single tokens because they are the suffix of a scenario name.'
}

Table shared.climate_zones {
  climate_zone_id integer [increment, pk]
  climate_zone_name "character varying(10)" [not null, note: 'Köppen climate classification code (e.g., Cfb, Dfb, ET, EF, BWh)']
  description text

  indexes {
    climate_zone_name [unique]
  }

  Note: 'Köppen climate classification zones'
}

Table shared.disturbance_events {
  disturbance_event_id integer [increment, pk]
  location_id integer [not null]
  plot_id integer
  disturbance_type "character varying(50)" [not null, note: 'Type of natural disturbance']
  event_date date [not null]
  end_date date
  severity "character varying(20)" [note: 'Disturbance severity level']
  affected_area_m2 numeric(12,2) [note: 'Estimated area affected in m²']
  description text
  notes text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  Note: 'Natural disturbance events affecting forest areas (storms, fire, insects, etc.)'
}

Table shared.disturbance_events_trees {
  disturbance_event_id integer
  tree_id integer
  damage_level "character varying(50)" [note: 'Level of damage to individual tree']
  notes text

  indexes {
    (disturbance_event_id, tree_id) [pk]
  }

  Note: 'Links disturbance events to affected individual trees with damage assessment'
}

Table shared.locations {
  location_id integer [increment, pk]
  location_name "character varying(200)" [not null]
  boundary geometry(Polygon,4326) [note: 'PostGIS polygon defining plot boundaries in WGS84']
  center_point geometry(Point,4326) [note: 'PostGIS point for plot center in WGS84']
  description text
  elevation_m numeric(8,2)
  slope_deg numeric(5,2)
  aspect "character varying(3)"
  soil_type_id integer
  climate_zone_id integer
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"
  forest_growth_region "character varying(16)" [note: 'German forest growth region code (Wuchsgebiet.Wuchsbezirk), e.g. \'99.73.11\'. Keys SILVA/silvaR\'s internal climate table, which supplies temperature, precipitation and vegetation-period length for the site. Derived once by point-in-polygon against the Thuenen Wuchsbezirke 2020 layer; see silva-connector/docs/site-conditions.md for provenance.']
  soil_moistness smallint [note: 'SILVA soil moisture class, 1-9 (1 = very dry, 5 = fresh, 9 = very wet). Not derivable from soil_type_id: shared.soil_types holds USDA soil orders (Alfisol, Spodosol, ...), which describe pedogenesis rather than water supply. Requires a site survey value.']
  soil_nutrient_supply smallint [note: 'SILVA soil nutrient supply class, 1-5 (1 = very low, 5 = very high). Like soil_moistness, independent of the USDA order in soil_type_id and requires a site survey value.']
  crs_epsg integer [note: 'Declared internal projected CRS of the site as an EPSG code (e.g. 32632 = WGS 84 / UTM zone 32N). The one frame in which per-site planimetric work (engine placement, terrain, distances) is done; every input in another frame is transformed on ingestion and its source frame retained on the record (trees.trees.source_crs / position_original). Geometry columns stay EPSG:4326. Seeded from data/lookups/locations.csv.']

  indexes {
    location_name [unique]
  }

  Note: 'Forest plot locations with spatial boundaries and environmental context'
}

Table shared.lookup_registry {
  logical_key text [pk]
  schema_name text [not null]
  table_name text [not null]
  csv_file text [not null]
  csv_columns "text[]" [not null, note: 'Target column per CSV column, in file order. Length must equal the CSV\'s column count; the loader asserts this rather than trusting it.']
  natural_key text [not null]
  description text

  Note: 'Drives shared.refresh_lookup. csv_columns lists the TARGET column for each CSV column, in file order -- the CSV header is ignored, so a header whose spelling predates a column rename does not silently misload. natural_key is the column the upsert conflicts on.'
}

Table shared.management_events {
  management_event_id integer [increment, pk]
  location_id integer [not null]
  plot_id integer
  event_type "character varying(50)" [not null, note: 'Type of management activity']
  event_date date [not null]
  end_date date
  description text
  affected_area_m2 numeric(12,2) [note: 'Area affected by the management activity in m²']
  performed_by "character varying(200)"
  notes text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  Note: 'Forest management activities (thinning, planting, harvesting, etc.)'
}

Table shared.management_regimes {
  management_regime_id smallint [pk]
  management_regime_name "character varying(100)" [not null]
  description text
  silva_rules jsonb [note: 'silvaR thinning preset: {"removal_method","max_removal_fraction","rules":[{species, thinning_type, guide_curve, metric, intervention, crop_trees_per_ha, n_competitors, target_dbh_cm, target_probability}]}. Species by scientific name or "all". NULL = no management. silva-connector turns this into silva_thinning_regime().']
  created_at "timestamp with time zone" [default: `now()`]

  indexes {
    management_regime_name [unique]
  }

  Note: 'Management axis of a scenario. Small integer id + snake_case name, so Unreal can sort on the number and label with the text. Regime 0 (none) marks scenarios that hold acquired data only, never trees.'
}

Table shared.plots {
  plot_id integer [increment, pk]
  location_id integer [not null]
  plot_name "character varying(200)" [not null, note: 'Plot identifier, unique within a location']
  plot_number integer [note: 'Numeric plot identifier for ordering']
  area_m2 numeric(12,2) [note: 'Plot area in square meters']
  boundary geometry(Polygon,4326) [note: 'PostGIS polygon defining plot boundaries in WGS84']
  center_point geometry(Point,4326)
  description text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  indexes {
    (location_id, plot_name) [unique]
  }

  Note: 'Sub-plot divisions within locations for detailed research grids'
}

