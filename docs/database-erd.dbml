Table trees.growth_simulations {
  growth_simulation_id bigint [increment, pk]
  simulation_run_id uuid [not null, note: 'UUID identifying a single simulation run. All rows with the same run_id belong to one simulator execution and can be compared as a complete forest state.']
  tree_entity_id uuid [not null, note: 'Stable UUID of the physical tree (cross-variant identity from trees.trees.tree_entity_id).']
  base_tree_id integer [note: 'trees.trees row (tree_id) used as the simulation input (baseline measurement).']
  location_id integer
  plot_id integer
  scenario_id integer
  species_id integer
  simulator_name "character varying(100)" [not null]
  simulator_version "character varying(50)"
  projection_year integer [not null, note: 'Calendar year this projection describes.']
  time_delta_yrs numeric(8,2)
  height_m numeric(6,2)
  dbh_cm numeric(6,2)
  basal_area_m2 numeric(8,4)
  crown_width_m numeric(6,2)
  crown_base_height_m numeric(6,2)
  volume_m3 numeric(10,3)
  biomass_kg numeric(12,2)
  carbon_content_kg numeric(12,2)
  health_score numeric(3,2)
  is_mortality boolean [not null, default: `false`, note: 'True if this tree dies in this projection time step.']
  stand_basal_area_m2ha numeric(8,4) [note: 'Stand-level basal area (m²/ha) — same value repeated for all trees in this run_id+Year.']
  stand_volume_m3ha numeric(10,3)
  stand_biomass_tha numeric(10,3)
  stand_stem_count_ha integer
  created_at "timestamp with time zone" [not null, default: `now()`]
  created_by "character varying(200)"

  Note: 'Per-tree forest growth projections from SILVA, FVS, iLand, or manual estimation. One row per (run_id, tree_entity_id, projection_year). run_id groups all rows produced by a single simulation run.'
}

Table trees.phanerophyte_height_classes {
  height_class_id integer [increment, pk]
  height_class_name "character varying(50)" [not null]
  description text
  min_height_m numeric(6,2) [note: 'Minimum height for this class (NULL = no lower bound)']
  max_height_m numeric(6,2) [note: 'Maximum height for this class (NULL = no upper bound)']

  indexes {
    height_class_name [unique]
  }

  Note: 'Tree height classification (mega/meso/micro-phanerophyte)'
}

Table trees.phenology_observations {
  phenology_observation_id integer [increment, pk]
  tree_id integer [not null]
  observation_date date [not null]
  phenophase_type "character varying(50)" [not null, note: 'Type of phenological phase being observed']
  phenophase_status "character varying(50)" [note: 'Current status of the phenophase']
  intensity_percent numeric(5,2) [note: 'Intensity of the phenophase (0-100%)']
  observer "character varying(200)"
  notes text
  created_at "timestamp with time zone" [default: `now()`]
  created_by "character varying(200)"

  Note: 'Tree phenology observations tracking seasonal development phases'
}

Table trees.qsm_cylinders {
  qsm_cylinder_id bigint [increment, pk]
  qsm_id bigint [not null]
  cylinder_index integer [not null, note: 'Cylinder id within the QSM, as published (rTwig \'id\')']
  parent_cylinder_index integer [note: 'Parent cylinder_index, self-referenced by index (not FK) to match the source files -- 0 for the base cylinder, per rTwig convention']
  start_point geometry(PointZ) [note: 'Cylinder base coordinate in the QSM\'s local frame (trees.qsms.local_crs / origin_position)']
  axis "double precision[]" [note: 'Unit vector [x,y,z] from cylinder base to top']
  length_m numeric(8,4) [not null, note: 'Cylinder length; 0 is allowed because TreeQSM output contains zero-length cylinders that other cylinders hang off']
  radius_m numeric(8,5) [not null, note: 'Radius as the source delivered it: radius-corrected where the source corrects (see trees.qsms.is_corrected), raw otherwise']
  branch_index integer [note: 'Axis (branch) id from 1, by the lab\'s single axis rule (the child with the longer supported subtree continues the axis), not the producing tool\'s own id']
  branch_order integer [note: 'Axis order, 0 = trunk, by the same single axis rule']
  branch_position integer [note: 'Position along the axis, from 1 at its base']
  part_type_id smallint [note: 'CityGML part semantic (trunk/branch/twig) -- see trees.tree_part_types; assignment rule documented in this migration\'s header']
  created_at "timestamp with time zone" [default: `now()`]
  raw_radius_m numeric(8,5) [note: 'Radius of the fitted cylinder before any correction (rTwig raw_radius, TreeQSM UnmodRadius); NULL when the source does not keep it']
  is_virtual boolean [not null, default: `false`, note: 'Cylinder added to bridge a gap in the point cloud (TreeQSM added, TreeML addedVirtual), not fitted to points']

  indexes {
    (qsm_id, cylinder_index) [unique]
  }

  Note: 'QSM cylinder geometry, Real Twig / rTwig standardised column set -- ~10^3-10^4 rows per tree'
}

Table trees.qsms {
  qsm_id bigint [increment, pk]
  tree_entity_id uuid [not null, note: 'Stable physical-tree identity (trees.trees.tree_entity_id) -- groups QSMs of the same tree across scans/tools/parameter sets']
  tree_id integer [not null]
  point_cloud_id integer
  process_id integer
  lod smallint [note: 'CityGML representation level of detail, 0-4: 0 = 2D footprint, 1 = 2.5D height/root depth, 2 = crown + trunk as separable volumes, 3 = 3D morphological structure, 4 = internal detail plus structured semantics. This is the ONLY meaning of "LoD" in this database. It is not a rendering resolution and not a count of which parts exist -- for those see the render-resolution and structural-detail axes in docs/level-of-detail-vocabulary.md (XRFF-404).']
  local_crs text [note: 'CRS of the cylinder coordinates in trees.qsmcylinders, or the literal value \'local\' if none']
  origin_position geometry(PointZ,4326) [note: 'Georeferences the local cylinder coordinate frame']
  cylinder_count integer
  total_volume_m3 numeric(10,3) [note: 'QSM-derived total volume -- kept separate from the allometric trees.trees.volume_m3']
  trunk_volume_m3 numeric(10,3)
  branch_volume_m3 numeric(10,3)
  dbh_qsm_cm numeric(6,2) [note: 'DBH as derived from the QSM -- kept separate from trees.stems.dbh_cm to allow validating one against the other']
  height_qsm_m numeric(6,2)
  crown_area_qsm_m2 numeric(10,2)
  is_corrected boolean [not null, default: `false`, note: 'Raw TreeQSM (false) vs Real Twig radius-corrected (true)']
  created_at "timestamp with time zone" [default: `now()`]
  created_by "character varying(200)"

  Note: 'QSM (Quantitative Structure Model) reconstructions -- one row per reconstruction, several per physical tree possible'
}

Table trees.root_system_types {
  root_system_type_id smallint [increment, pk]
  root_system_type_name "character varying(50)" [not null]
  description text

  indexes {
    root_system_type_name [unique]
  }

  Note: 'Root system morphology lookup (Koestler et al. 1968 classification; Guerrero Inigez 2017 LoD-matched geometric models)'
}

Table trees.roots {
  root_id bigint [increment, pk]
  tree_entity_id uuid [not null, note: 'Stable physical-tree identity (trees.trees.tree_entity_id)']
  tree_id integer [not null]
  root_system_type_id smallint [not null]
  lod smallint [note: 'CityGML representation level of detail, 0-4; same ladder as trees.qsms.lod. Read together with geometry_class: implicit = a prototype instanced with a transform (a generic asset placed on this tree), explicit = this tree\'s own geometry. The number alone cannot tell those apart. See docs/level-of-detail-vocabulary.md (XRFF-404).']
  geometry_class text [note: 'implicit = prototype instanced with a transform, so LoD2-LoD3 at best; explicit = this tree\'s own measured geometry, which is what qualifies a row as LoD4. Always interpreted alongside lod, never on its own. See docs/citygml-qsm-mapping.md §5.']
  root_depth_m numeric(6,2)
  root_spread_radius_m numeric(6,2)
  process_id integer
  source text [not null, note: 'species_default = classified from silvics literature, no measurement; field_observed = seen but not measured; measured = geometry actually captured']
  created_at "timestamp with time zone" [default: `now()`]
  created_by "character varying(200)"

  Note: 'Root system classification/geometry (Guerrero Inigez 2017 LoD-matched models) -- classifiable from species now, geometrized later'
}

Table trees.shoot_elongation_types {
  shoot_elongation_type_id integer [increment, pk]
  shoot_elongation_type_name "character varying(50)" [not null]
  description text

  indexes {
    shoot_elongation_type_name [unique]
  }

  Note: 'Shoot elongation classification (long, short, spur shoots)'
}

Table trees.simulation_runs {
  simulation_run_id uuid [pk]
  location_id integer [not null]
  scenario_id integer
  base_variant_id integer [note: 'shared.variants row the run was projected forward from. The reproducibility anchor: variant names are reused and deleted by --replace, so the reference is stored, not the name.']
  base_year integer [note: 'Calendar year of the base variant (year zero). First projected year = base_year + one simulator period.']
  simulator_name "character varying(100)" [not null]
  simulator_version "character varying(50)"
  process_id integer [note: 'shared.processes row the run registered itself under (algorithm, version, citation).']
  horizon_years integer [note: 'Projection horizon in years, as requested (silva-connector: --years, a multiple of 5).']
  seed integer [note: 'Random seed. The one parameter that makes two otherwise identical runs differ, and the reason this table exists.']
  is_mortality_enabled boolean [note: 'True if the simulator was allowed to kill trees during the run.']
  is_promoted boolean [note: 'True if the run was promoted to the shared.variants chain UE reads. False for a comparison-only run (silva-connector --no-promote).']
  run_params jsonb [not null, default: `'{}'::jsonb`, note: 'Simulator-specific parameters as named keys, e.g. {"competition": "sf_polygon", "variant_prefix": "silva", "replace": true}. Named parameters only -- never a command line. An absent key on a run predating 2026-09-02 means the value was not recorded, not that it was unset.']
  created_at "timestamp with time zone" [not null, default: `now()`]
  created_by "character varying(200)"

  Note: 'One row per forest growth simulation run: what was simulated, by which simulator, and with which parameters. trees.growth_simulations holds the per-tree result rows of a run and references this table by run_id.'
}

Table trees.stems {
  stem_id integer [increment, pk]
  tree_id integer [not null]
  stem_number integer [not null, note: 'Stem number (1=main stem, 2+=secondary stems)']
  taper_type_id integer
  straightness_type_id integer
  dbh_cm numeric(6,2) [note: 'Diameter at breast height (1.3m) in centimeters']
  taper_ratio numeric(4,3) [note: 'Ratio of top diameter to bottom diameter']
  sweep_cm_per_m numeric(5,2) [note: 'Maximum horizontal deviation per meter of height']
  stem_height_m numeric(6,2)
  stem_volume_m3 numeric(10,3)
  bark_thickness_mm numeric(5,2)
  wood_density_kg_m3 numeric(6,2)
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"

  indexes {
    (tree_id, stem_number) [unique]
  }

  Note: 'Individual stem measurements for multi-stem trees'
}

Table trees.straightness_types {
  straightness_type_id integer [increment, pk]
  straightness_type_name "character varying(100)" [not null]
  description text
  deviation_angle_min_deg numeric(5,2)
  deviation_angle_max_deg numeric(5,2)

  indexes {
    straightness_type_name [unique]
  }

  Note: 'Stem straightness classifications'
}

Table trees.taper_types {
  taper_type_id integer [increment, pk]
  taper_type_name "character varying(100)" [not null]
  description text
  typical_taper_ratio_min numeric(4,3) [note: 'Minimum typical taper ratio (diameter at top / diameter at bottom)']
  typical_taper_ratio_max numeric(4,3)

  indexes {
    taper_type_name [unique]
  }

  Note: 'Stem taper form classifications'
}

Table trees.tree_graph_edges {
  tree_graph_edge_id bigint [increment, pk]
  qsm_id bigint [not null]
  from_cylinder_index integer [not null, note: 'Parent cylinder_index -- the CityGML Edge\'s first Node']
  to_cylinder_index integer [not null, note: 'Child cylinder_index -- the CityGML Edge\'s second Node']
  edge_type text [not null, note: 'observed = measured by the source; synthetic = the source itself flagged this as inferred; derived = we added/overrode it ourselves']
  created_at "timestamp with time zone" [default: `now()`]

  indexes {
    (qsm_id, from_cylinder_index, to_cylinder_index) [unique]
  }

  Note: 'QSM topology edges whose type deviates from the trees.qsmcylinders parent-chain default (\'observed\'); see this migration\'s header for the observed/synthetic/derived distinction'
}

Table trees.tree_part_types {
  part_type_id smallint [increment, pk]
  part_type_name "character varying(50)" [not null]
  description text

  indexes {
    part_type_name [unique]
  }

  Note: 'CityGML tree feature-class lookup (Ambarwari et al. 2024) -- join point for a future CityGML ADE'
}

Table trees.tree_status {
  tree_status_id integer [increment, pk]
  tree_status_name "character varying(100)" [not null]
  description text

  indexes {
    tree_status_name [unique]
  }

  Note: 'Tree health and status classification'
}

Table trees.trees {
  tree_id integer [increment, pk, note: 'Unique row identifier for this tree record']
  tree_entity_id uuid [default: `gen_random_uuid()`, note: 'Persistent UUID identifying the physical tree across all variants']
  variant_id integer [note: 'Forest state group — all trees sharing this variant_id belong to the same time step within a scenario. Use for UE time-travel switching.']
  parent_tree_id integer [note: 'Parent tree record for tracking growth or modifications']
  point_cloud_id integer [note: 'Source point cloud if tree was detected from LiDAR']
  campaign_id integer [note: 'Data collection campaign this measurement belongs to']
  location_id integer [not null]
  plot_id integer [note: 'Sub-plot within the location where tree is located']
  scenario_id integer
  variant_type_id integer [not null]
  process_id integer
  species_id integer
  tree_status_id integer
  branching_pattern_id integer
  bark_characteristic_id integer
  measurement_date date [note: 'Actual date of field measurement (may differ from created_at)']
  data_source_type_id integer [note: 'FK to trees.data_source_types — how the data was collected or generated']
  height_m numeric(6,2)
  height_source "character varying(50)" [note: 'How height_m was arrived at. NULL means unrecorded -- it is not a claim that the height was measured. Values in use: \'measured\' (field instrument), \'allometric_pylometree\' (H-D model fill, see scripts/import/fill_missing_heights.py), \'simulated_silva\' (SILVA projection, see silva-connector). Pair with data_source_type_id, which records how the tree record as a whole was produced, and process_id, which identifies the run.']
  crown_width_m numeric(6,2)
  crown_base_height_m numeric(6,2)
  crown_boundary geometry(Polygon,4326) [note: 'PostGIS polygon defining crown extent']
  crown_offset_x_m numeric(5,2) [note: 'Crown center offset from trunk position (X/East-West in meters)']
  crown_offset_y_m numeric(5,2) [note: 'Crown center offset from trunk position (Y/North-South in meters)']
  volume_m3 numeric(10,3)
  position geometry(Point,4326) [not null, note: 'PostGIS point for tree location in WGS84']
  position_original geometry [note: 'Original coordinates in source CRS before WGS84 transformation']
  source_crs integer [note: 'EPSG code of original coordinate reference system for position_original']
  lean_angle_deg numeric(5,2)
  lean_direction_azimuth integer
  time_delta_yrs numeric(8,2) [note: 'Time elapsed since parent variant (for growth simulations)']
  age_years integer
  health_score numeric(3,2) [note: 'Tree health assessment score (0=dead, 1=optimal)']
  biomass_kg numeric(12,2)
  carbon_content_kg numeric(12,2)
  species_confidence numeric(3,2) [note: 'Confidence in species identification (0-1)']
  position_confidence numeric(3,2) [note: 'Confidence in position accuracy (0-1)']
  height_confidence numeric(3,2) [note: 'Confidence in height measurement (0-1)']
  status_change_date date [note: 'Date when tree status changed (e.g., mortality date)']
  tree_number integer [note: 'Local tree identifier within the location/plot (e.g., 62 in ecosense plot 4, or 367 in mathisle)']
  field_notes text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"
  height_class_id integer [note: 'Phanerophyte height classification']
  crown_architecture_id integer [note: 'Crown architecture type (excurrent, decurrent, etc.)']
  elongation_habit_id integer [note: 'Branch elongation pattern (acrotony, mesotony, basitony)']
  growth_orientation_id integer [note: 'Predominant growth orientation (orthotropic/plagiotrophic)']
  shoot_elongation_type_id integer [note: 'Typical shoot elongation type']
  crown_shape_id integer [note: 'Observed crown shape']
  geometric_crown_solid_id integer [note: 'Geometric model for crown volume/drag calculations']
  axis_structure_id integer [note: 'Main axis structure (single leader/polycormic)']
  growth_form_id integer [note: 'General growth form classification']
  live_crown_ratio numeric(4,3) [note: 'generated: CASE WHEN ((height_m IS NOT NULL) AND (height_m > (0)::numeric) AND (crown_base_height_m IS NOT NULL)) THEN ((height_m - crown_base_height_m) / height_m) ELSE NULL::numeric END']
  crown_class_id integer [note: 'Crown competitive/social position (dominant/co_dominant/intermediate/overtopped/open_grown)']
  damage_agent_id integer [note: 'Primary agent responsible for observed damage or decline, if any']
  defoliation_percent numeric(5,2) [note: 'ICP Forests-style defoliation assessment (0-100%, in 5% steps by convention)']
  discolouration_percent numeric(5,2) [note: 'ICP Forests-style foliage discolouration assessment (0-100%)']
  crown_transparency_percent numeric(5,2) [note: 'ICP Forests-style crown transparency assessment (0-100%)']
  sensor_ref "character varying(100)" [note: 'Source-agnostic reference identifying the sensor cluster installed on this tree. Matches the prefix of sensor.sensors.serial_number, so all of a tree\'s sensors resolve from it. For the current Ecosense data this value is the external provider\'s name prefix (e.g. Beech_Mixed_8), but the column carries no provider semantics. NULL for non-instrumented trees.']

  Note: 'Tree measurement and simulation records with spatial positions'
}

Table sensor.sensor_readings {
  sensor_reading_id bigint [increment, pk]
  sensor_id integer [not null]
  timestamp "timestamp with time zone" [not null]
  value numeric(12,4) [not null]
  quality "character varying(50)" [note: 'Data quality flag (good, suspect, bad, missing, calibration)']
  scenario_id integer [note: 'NULL for real readings, references scenario for simulated data']
  battery_voltage_v numeric(4,2)
  signal_strength numeric(6,2) [note: 'Wireless signal strength in dBm']
  notes text
  created_at "timestamp with time zone" [default: `now()`]

  indexes {
    (sensor_id, timestamp) [unique]
  }

  Note: 'Time-series environmental sensor measurements'
}

Table sensor.sensor_tree_links {
  sensor_tree_link_id integer [increment, pk, note: 'Surrogate key. Renamed from sensortreelinkid in XRFF-488 -- it was the only primary key in the database not spelled <stem>_id.']
  sensor_id integer [not null]
  tree_id integer [not null]
  description text
  start_date date
  end_date date
  created_at "timestamp with time zone" [default: `now()`]

  indexes {
    (sensor_id, tree_id) [unique]
  }

  Note: 'Links sensors to specific tree records'
}

Table sensor.sensor_types {
  sensor_type_id integer [increment, pk]
  sensor_type_name "character varying(100)" [not null]
  description text
  typical_unit "character varying(50)" [note: 'Default unit for this sensor type, from sensor.units. NULL where the type has no single natural unit.']
  typical_range_min numeric(12,4)
  typical_range_max numeric(12,4)

  indexes {
    sensor_type_name [unique]
  }

  Note: 'Environmental sensor type classifications'
}

Table sensor.sensors {
  sensor_id integer [increment, pk]
  location_id integer [not null]
  sensor_type_id integer [not null]
  campaign_id integer [note: 'Deployment campaign this sensor was installed during']
  plot_id integer [note: 'Named monitoring sub-area (plot) within the location, e.g. douglas_fir_plot. Populated from the location identifier of the external sensor sync; the site is location_id.']
  sensor_model "character varying(200)" [not null]
  serial_number "character varying(100)"
  position geometry(Point,4326) [not null, note: 'PostGIS point for sensor location in WGS84']
  position_original geometry [note: 'Original coordinates in source CRS before WGS84 transformation']
  source_crs integer [note: 'EPSG code of original coordinate reference system for position_original']
  installation_date "timestamp with time zone" [not null, default: `now()`]
  installation_height_m numeric(5,2) [note: 'Height of sensor installation above ground in meters']
  decommission_date "timestamp with time zone"
  calibration_date "timestamp with time zone"
  next_calibration_date "timestamp with time zone"
  sampling_interval_seconds integer [not null, note: 'Frequency of sensor measurements in seconds']
  unit "character varying(50)" [note: 'Canonical unit of this sensor\'s readings, from sensor.units. ASCII with _ as the divisor; render sensor.units.unit_display instead of this value.']
  min_value numeric(12,4)
  max_value numeric(12,4)
  accuracy numeric(8,4)
  battery_level_percent numeric(5,2)
  is_active boolean [default: `true`, note: 'Whether sensor is currently collecting data']
  maintenance_notes text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"
  source text [note: 'External system this sensor\'s data comes from (e.g. \'aquarius\'). One of many possible providers.']
  external_id "character varying(200)" [note: 'Unique identifier for this sensor within its source system (see source).']
  external_metadata jsonb [default: `'{}'::jsonb`, note: 'Additional source-specific metadata (raw payload from the provider).']

  indexes {
    external_id [unique]
  }

  Note: 'Sensors and the series they produce, physical or modelled. Most rows are physical installations with an instrument, a serial number and a position. Rows whose `source` names a model or reanalysis (e.g. \'open-meteo\') are virtual: one series per location and quantity, no hardware, `serial_number` NULL and no entry in sensor.sensor_tree_links. Discriminate on `source`, never on `sensor_type_id` -- the types are quantities, shared by both kinds.'
}

Table sensor.units {
  unit_id integer [increment, pk]
  unit_name "character varying(32)" [not null]
  unit_display "character varying(32)" [not null]
  description text

  indexes {
    unit_name [unique]
  }

  Note: 'Canonical physical units for sensor.sensors.unit and sensor.sensor_types.typical_unit. unit_name is ASCII with _ as the divisor so it survives JSON, CSV, R and Unreal DataTable round trips; unit_display is the symbol to render.'
}

Table environments.environments {
  environment_id integer [increment, pk, note: 'Unique identifier for this environment record']
  parent_environment_id integer [note: 'Parent environment for tracking environmental modifications']
  location_id integer [not null]
  scenario_id integer
  variant_type_id integer [not null]
  process_id integer
  variant_name "character varying(300)" [not null]
  start_date "timestamp with time zone" [note: 'Start of environmental measurement period']
  end_date "timestamp with time zone" [note: 'End of environmental measurement period (NULL for ongoing)']
  avg_temperature_c numeric(6,2)
  avg_humidity_percent numeric(5,2)
  total_precipitation_mm numeric(8,2)
  avg_global_radiation_w_m2 numeric(8,2) [note: 'Average global radiation in W/m²']
  avg_co2_ppm numeric(7,2)
  avg_wind_speed_ms numeric(6,2)
  dominant_wind_direction_deg numeric(5,2)
  avg_soil_moisture_percent numeric(5,2)
  avg_soil_temperature_c numeric(6,2)
  soil_ph numeric(4,2)
  nutrient_nitrogen_mg_kg numeric(8,2)
  nutrient_phosphorus_mg_kg numeric(8,2)
  nutrient_potassium_mg_kg numeric(8,2)
  stress_factor numeric(3,2) [note: 'Environmental stress index (0=optimal, 1=severe stress)']
  description text
  research_notes text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  Note: 'Environmental condition variants derived from sensors, models, or user input'
}

Table pointclouds.point_clouds {
  point_cloud_id integer [increment, pk, note: 'Unique identifier for this point cloud record']
  parent_point_cloud_id integer [note: 'Parent point cloud for processing lineage tracking']
  location_id integer [not null]
  scenario_id integer
  variant_type_id integer [not null]
  process_id integer
  campaign_id integer [note: 'Data collection campaign this scan belongs to']
  scanner_id integer [note: 'Physical scanner hardware used for this scan']
  variant_name "character varying(300)" [not null]
  scan_date "timestamp with time zone"
  sensor_model "character varying(200)"
  source_crs integer [note: 'EPSG code of original coordinate reference system']
  platform_type "character varying(50)" [note: 'Scanning platform: terrestrial, aerial, mobile, UAV']
  scan_bounds geometry(Polygon,4326) [note: 'PostGIS polygon defining point cloud coverage area in WGS84']
  file_path text [not null, note: 'S3 URI to point cloud file (e.g., s3://bucket-name/path/file.las)']
  flight_altitude_m numeric(8,2) [note: 'Flight altitude above ground in meters (for aerial/UAV)']
  flight_speed_ms numeric(6,2) [note: 'Platform speed during scanning in m/s']
  scan_angle_deg numeric(5,2) [note: 'Scanner field of view angle in degrees']
  overlap_percent numeric(5,2) [note: 'Swath overlap percentage (for aerial scans)']
  point_count bigint
  point_density_per_m2 numeric(10,2) [note: 'Average point density in points per square meter']
  file_size_mb numeric(12,2)
  processing_status "character varying(50)" [note: 'NULL for original scans, status for processed variants']
  processing_progress numeric(5,2) [note: 'Processing completion percentage (0-100)']
  error_message text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  Note: 'LiDAR point cloud variants - original scans and processed results'
}

Table pointclouds.scanner_types {
  scanner_type_id integer [increment, pk]
  scanner_type_name "character varying(100)" [not null, note: 'Scanner type name (e.g., Terrestrial_TLS, Aerial_ALS, Mobile_MLS, UAV_ULS)']
  manufacturer "character varying(200)"
  description text

  indexes {
    scanner_type_name [unique]
  }

  Note: 'LiDAR scanner type classifications and manufacturers'
}

Table pointclouds.scanners {
  scanner_id integer [increment, pk]
  scanner_type_id integer [not null]
  serial_number "character varying(100)" [note: 'Unique hardware serial number']
  acquisition_date date [note: 'Date scanner was acquired']
  calibration_date date [note: 'Last calibration date']
  notes text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"

  indexes {
    serial_number [unique]
  }

  Note: 'Individual LiDAR scanner hardware instances'
}

Table imagery.images {
  image_id integer [increment, pk]
  location_id integer [not null]
  plot_id integer
  campaign_id integer
  capture_date "timestamp with time zone"
  file_path text [not null, note: 'Path or URI to image file']
  file_format "character varying(20)" [note: 'Image file format (jpg, png, tiff, raw, geotiff)']
  resolution_px "character varying(50)" [note: 'Image resolution in pixels (e.g., 4000x3000)']
  camera_model "character varying(200)"
  position geometry(Point,4326) [note: 'Camera position in WGS84 (EPSG:4326)']
  altitude_m numeric(8,2) [note: 'Camera altitude above ground in meters']
  heading_deg numeric(5,2) [note: 'Camera heading in degrees (0=North, clockwise)']
  pitch_deg numeric(5,2) [note: 'Camera pitch angle (-90 to 90 degrees)']
  roll_deg numeric(5,2) [note: 'Camera roll angle (-180 to 180 degrees)']
  ground_sample_distance_cm numeric(8,4) [note: 'Ground sample distance in centimeters per pixel']
  description text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  created_by "character varying(200)"
  updated_by "character varying(200)"

  Note: 'Aerial and ground-based imagery with spatial metadata and camera parameters'
}

Table forest_floor.deadwood {
  deadwood_id integer [increment, pk]
  location_id integer [not null]
  plot_id integer
  tree_id integer [note: 'Optional link to known dead tree record']
  species_id integer
  wood_type "character varying(50)" [not null, note: 'Type of dead wood: standing, fallen, stump, or branch']
  length_m numeric(6,2)
  diameter_cm numeric(6,2)
  decay_class integer [note: 'Decay stage from 1 (fresh) to 5 (fully decomposed)']
  volume_m3 numeric(10,3)
  position geometry(Point,4326)
  measurement_date date
  notes text
  created_at "timestamp with time zone" [default: `now()`]
  created_by "character varying(200)"

  Note: 'Dead wood inventory including standing dead, fallen logs, stumps, and branches'
}

Table forest_floor.ground_vegetation {
  ground_vegetation_id integer [increment, pk]
  location_id integer [not null]
  plot_id integer
  species_name "character varying(200)"
  cover_percent numeric(5,2) [note: 'Estimated cover percentage (0-100)']
  height_cm numeric(6,2)
  layer "character varying(50)" [note: 'Vegetation layer: herb, shrub, moss, litter, fern, grass']
  measurement_date date
  notes text
  created_at "timestamp with time zone" [default: `now()`]
  created_by "character varying(200)"

  Note: 'Ground vegetation survey records by plot and layer'
}

