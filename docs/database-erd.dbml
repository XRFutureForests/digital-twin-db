Table shared.processes {
  process_id integer [increment, pk]
  process_name "character varying(200)" [not null, note: 'Process name (e.g., LiDAR_Segmentation, Tree_Detection, Growth_Simulation)']
  algorithm_name "character varying(200)" [note: 'Algorithm used (e.g., RandomForest, DeepLearning, RulesBased)']
  version "character varying(50)"
  description text
  author "character varying(200)"
  publication_date date
  citation text
  category "character varying(100)" [note: 'What kind of step this is. `acquisition` (added 2026-09-02) is a fetch from an external system -- Aquarius, ERA5, SoilGrids -- as opposed to a computation over data already held.']
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  param_schema jsonb [note: 'JSON Schema for the workflow\'s run_params. Properties marked "readOnly": true are recorded by the run rather than offered by the job menu -- web/jobs skips them when building its form, and emit_ro_crate includes them in the reproducibility record. Every key a run writes into run_params must be declared here; tests/automated/e2e/provenance/test_ro_crate.py asserts it.']
  workflow_key "character varying(50)" [note: 'Short machine name of a runnable workflow -- the string request_job() takes and the runner matches against its local workflows.toml. NULL means the row is provenance only: it records what produced some data and cannot be requested. UNIQUE, so exactly one row (one version) is runnable per workflow; on a version bump the key is moved to the new row, not copied.']

  indexes {
    (process_name, version) [unique]
    workflow_key [unique]
  }

  Note: 'Processing algorithms and methods with versioning and academic attribution'
}

Table shared.processing_jobs {
  processing_job_id integer [increment, pk]
  external_job_id "character varying(200)" [note: 'Idempotency key supplied by the caller. Already UNIQUE, and adopted as the deduplication key: enqueueing the same key twice yields one job, so a repeated request from VR or a double-clicked button cannot start the same run twice. NULL for jobs that do not need deduplication.']
  workflow_name "character varying(200)" [not null]
  workflow_version "character varying(50)"
  status "character varying(50)" [not null, default: `'pending'::character varying`, note: 'Job status: pending, running, completed, failed']
  submitted_at "timestamp with time zone" [not null, default: `now()`]
  completed_at "timestamp with time zone"
  input_data jsonb [note: 'JSON representation of input parameters and data references']
  output_data jsonb [note: 'JSON representation of output data references and results']
  error_message text
  submitted_by "character varying(200)"
  started_at "timestamp with time zone" [note: 'When a runner claimed the job and began executing it. NULL while pending.']
  claimed_by "character varying(200)" [note: 'Identity of the runner instance holding the job (host and process), so `runner reap` can tell a live claim from an abandoned one.']
  attempts integer [not null, default: `0`, note: 'How many times the job has been claimed. Incremented on claim, so an abandoned job that is reaped and re-queued is not retried forever.']
  max_attempts integer [not null, default: `1`, note: 'Claim budget. DEFAULT 1 = no automatic retry, which is the v1 policy: these workflows fail for parameter reasons far more often than transient ones.']
  next_attempt_at "timestamp with time zone" [note: 'Earliest time a runner may claim the job. NULL means immediately. Set by `runner reap` to hold a recovered job back.']

  indexes {
    external_job_id [unique]
  }

  Note: 'Tracks external processing jobs and compute workflows'
}

Table shared.scenarios {
  scenario_id integer [increment, pk]
  scenario_name "character varying(200)" [not null]
  description text
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  location_id integer [not null, note: 'The site this management regime belongs to — top of the Location -> Scenario -> Variant hierarchy.']
  management_regime_id smallint [not null, note: 'Management axis -> shared.management_regimes. Filled from scenario_name by trigger when omitted (grammar: <pathway> | <regime> | <regime>_<pathway>).']
  climate_pathway_id smallint [not null, note: 'Climate axis -> shared.climate_pathways. 0 = historical. Filled from scenario_name by trigger when omitted.']
  scenario_code integer [note: 'generated: ((management_regime_id * 10) + climate_pathway_id)']

  indexes {
    (location_id, management_regime_id, climate_pathway_id) [unique]
    (location_id, scenario_name) [unique]
  }

  Note: 'One scenario per (location, management regime, climate pathway). scenario_code = regime*10 + pathway is the numeric key, scenario_name the text one; the name follows <pathway> | <regime> | <regime>_<pathway> and the axes are derived from it on insert when not given. Regime 0 scenarios hold acquired data only; the rest own a baseline and a variant timeline (Location -> Scenario -> Variant).'
}

Table shared.soil_types {
  soil_type_id integer [increment, pk]
  soil_type_name "character varying(100)" [not null, note: 'USDA soil classification type']
  description text

  indexes {
    soil_type_name [unique]
  }

  Note: 'USDA soil classification reference table'
}

Table shared.species {
  species_id integer [increment, pk]
  common_name "character varying(200)"
  scientific_name "character varying(200)" [not null]
  max_height_m numeric(6,2) [note: 'Maximum typical height in meters']
  max_dbh_cm numeric(6,2) [note: 'Maximum typical diameter at breast height in centimeters']
  typical_lifespan_years integer [note: 'Typical lifespan in years']
  growth_rate "character varying(20)" [note: 'Relative growth rate (very_slow, slow, moderate, fast, very_fast)']
  shade_tolerance "character varying(20)" [note: 'Shade tolerance level (very_low, low, moderate, high, very_high)']
  is_deciduous boolean [note: 'Whether species is deciduous (true) or evergreen (false), NULL if unknown']
  gbif_key integer
  gbif_accepted_name "character varying(200)"
  created_at "timestamp with time zone" [default: `now()`]
  updated_at "timestamp with time zone"
  leaf_type "character varying(20)" [note: 'Leaf habit: needleleaf (conifers, larch included) or broadleaf. Independent of is_deciduous. Matches the Copernicus Dominant Leaf Type classes.']

  indexes {
    scientific_name [unique]
  }

  Note: 'Tree species reference with growth characteristics'
}

Table shared.variant_types {
  variant_type_id integer [increment, pk]
  variant_type_name "character varying(100)" [not null]
  description text

  indexes {
    variant_type_name [unique]
  }

  Note: 'Types of data variants (original, processed, simulated, etc.)'
}

Table shared.variants {
  variant_id integer [increment, pk]
  location_id integer [not null, note: 'The forest site this variant belongs to — top level of the Location → Scenario → Variant hierarchy']
  scenario_id integer [not null, note: 'The scenario (set of assumptions) this variant belongs to']
  variant_type_id integer [not null, note: 'Type of data in this variant (original field measurement, simulated growth, etc.)']
  variant_name "character varying(200)" [not null]
  simulation_year integer [note: 'Calendar year this forest state represents']
  time_delta_yrs numeric(8,2) [note: 'Years elapsed from the scenario baseline']
  sort_order integer [not null, default: `0`, note: 'Display order for time-slider UI in UE (0=earliest)']
  description text
  created_at "timestamp with time zone" [default: `now()`]
  parent_variant_id integer [note: 'The variant this state developed from (baseline has none). Encodes the timeline/intervention lineage within a scenario.']

  indexes {
    (location_id, scenario_id, variant_name) [unique]
  }

  Note: 'Forest state snapshots — each row is one time step at one location within one scenario. variant_id groups all trees at that state. Use for UE time-travel switching.'
}

