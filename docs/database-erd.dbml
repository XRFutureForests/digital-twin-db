Project digital_forest_twin {
  database_type: 'PostgreSQL'
  Note: 'Forest digital twin: seven domain schemas, PostgreSQL 15 + PostGIS. Data dictionary: docs/database-dictionary.md'
}

Table shared.account_events {
  account_event_id bigint [pk]
  occurred_at "timestamp with time zone" [not null, default: `now()`]
  actor_id uuid
  actor_email text
  target_email text [not null]
  action text [not null]
  old_role text
  new_role text

  Note: 'Account creations, role changes and password resets made through public.create_account / set_account_role / reset_account_password. Written only by those functions; curators and admins can read it.'
}

Table shared.attribute_provenance {
  attribute_provenance_id integer [increment, pk]
  location_id integer [not null]
  column_name "character varying(64)" [not null, note: 'Name of the shared.locations column this row describes. Not FK-checkable; the allowed set is enforced by public.set_location_attributes, which is the only writer.']
  process_id integer [not null, note: 'shared.processes row for the source -- its name, version, licence and citation. NOT NULL: an acquired value with no registered source is exactly what this table exists to prevent.']
  fetched_at "timestamp with time zone" [not null, default: `now()`, note: 'When the value was retrieved from the source, which is not the same as when the source published it (shared.processes.publication_date) nor when the row was written.']
  source_uri text [note: 'Direct reference to the fetched artefact -- API request URL, DOI, or file identifier -- so a value can be traced to one retrieval, not just to a dataset.']
  license "character varying(100)" [note: 'Licence of the source value, e.g. CC-BY-4.0, Copernicus. Carried per value because this database is published and the attribution requirements travel with the data.']

  indexes {
    (location_id, column_name) [unique]
  }

  Note: 'Where each value in a shared.locations column came from: one row per (location, column), replaced when the value is refreshed. Written by public.set_location_attributes in the same transaction as the value itself, so an attribute cannot be updated without saying what produced it.'
}

Table shared.audit_log {
  audit_log_id bigint [increment, pk]
  field_name "character varying(200)" [not null, note: 'Name of the field that was changed']
  old_value text [note: 'Previous value (stored as JSON text)']
  new_value text [note: 'New value (stored as JSON text)']
  change_reason text
  user_id "character varying(200)"
  timestamp "timestamp with time zone" [default: `now()`]
  change_type "character varying(50)"
  ip_address inet
  user_agent text

  Note: 'Field-level change tracking with user attribution (linked via junction tables)'
}

Table shared.audit_log_environments {
  audit_log_id bigint
