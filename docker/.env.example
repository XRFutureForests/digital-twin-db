############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

# Generate secure random keys:
# - POSTGRES_PASSWORD, JWT_SECRET, PG_META_CRYPTO_KEY: openssl rand -base64 32
# - SECRET_KEY_BASE: openssl rand -base64 48 (minimum 64 chars)
# - VAULT_ENC_KEY: openssl rand -hex 16 (exactly 32 hex chars)
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# ANON_KEY and SERVICE_ROLE_KEY: generate with Supabase CLI or manually sign JWTs
# using the JWT_SECRET above. See https://supabase.com/docs/guides/self-hosting/docker
ANON_KEY=CHANGE_ME_signed_jwt_with_role_anon
SERVICE_ROLE_KEY=CHANGE_ME_signed_jwt_with_role_service_role
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
SECRET_KEY_BASE=CHANGE_ME_generate_with_openssl_rand_base64_48
VAULT_ENC_KEY=CHANGE_ME_generate_with_openssl_rand_hex_16
PG_META_CRYPTO_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32


############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Supavisor -- Database pooler
############
# Port Supavisor listens on for transaction pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543
# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20
# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100
# Unique tenant identifier
POOLER_TENANT_ID=digital-forest-twin-local
# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5


############
# API Proxy - Configuration for the Kong Reverse proxy.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############

# Add your custom schemas here (comma-separated)
PGRST_DB_SCHEMAS=public,storage,graphql_public,shared,pointclouds,trees,sensor,environments,imagery


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=http://localhost:8000

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true


############
# Data paths - where the database and uploaded files are kept on disk
############

# Two host paths, both unset by default. Leave them unset for local development:
# storage lands in ./volumes/storage inside the repo and PGDATA in a
# Docker-managed named volume.
#
# Set them on a host whose system disk is too small to carry the stack. On
# dt.unr.uni-freiburg.de the root LV is 28 GB and has repeatedly filled to the
# point where the server stopped answering, while /media/data is a 100 GB NFS
# export from ufr-dyn.isi1 that sits nearly empty. There, everything that grows
# goes on the network drive:
#
#   PGDATA_PATH=/media/data/dftdb/pgdata
#   STORAGE_PATH=/media/data/dftdb/storage
#
# The pgsodium key directory deliberately stays in its named volume: it is 140 kB
# that never grows, and bind-mounting an empty directory over it hides the .conf
# files postgresql.conf includes, which kills the postmaster at startup.
#
# Run scripts/server/setup-data-dirs.sh (as root) once before first start: the
# directories must exist and be owned by the container UIDs, and the NFS export
# is not writable by an unprivileged user.
#
# Trade-off, deliberately accepted for this host: PGDATA over NFS is slower than
# local disk and is only safe on a hard mount, because a soft mount can return
# an I/O error mid-fsync and corrupt the cluster. /media/data is mounted
# hard,vers=4.2,proto=tcp,local_lock=none, which is the configuration Postgres
# supports. Verify with `findmnt -no OPTIONS /media/data` after any remount, and
# keep the nightly dump running so a failed cluster is recoverable.
# STORAGE_PATH=./volumes/storage

# Add your OpenAI API key to enable SQL Editor Assistant
OPENAI_API_KEY=


############
# Functions - Configuration for Functions
############
# NOTE: VERIFY_JWT applies to all functions. Per-function VERIFY_JWT is not supported yet.
FUNCTIONS_VERIFY_JWT=false


############
# Logs - Configuration for Analytics
# Please refer to https://supabase.com/docs/reference/self-hosting-analytics/introduction
############

# Change vector.toml sinks to reflect this change
# these cannot be the same value
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME_random_string_min_20_chars
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME_random_string_min_20_chars_different_from_public

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details (not used for local development)
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=

# For CSV importer - points to Kong API gateway
SUPABASE_URL=http://localhost:8000
